# Credentials never belong in this repo.
# The DOC API key lives at ~/.config/doc-api/key (mode 600), outside this tree.
# It is read at build time only; no key is ever written into index.html.
key
*.key
.env
.env.*
secrets.json
*.pem

# Scratch and backups
*.bak
*.orig
*~
/tmp/
fwh-index-backup-*.html

# Python
__pycache__/
*.pyc

# OS
.DS_Store
Thumbs.db
